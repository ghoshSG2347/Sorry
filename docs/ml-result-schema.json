{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://poisontrace.org/schemas/ml-result-v1.json",
  "title": "PoisonTrace ML Result Schema",
  "description": "Standardized output contract for PoisonTrace machine learning runs (both live execution and replay mode).",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "scenario_id",
    "mode",
    "status",
    "seeds",
    "protocol_ref",
    "baseline",
    "artifact_hashes",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of this result schema (e.g. '1.0.0')."
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for this evaluation run (e.g. UUID v4 or deterministic fixture ID)."
    },
    "scenario_id": {
      "type": "string",
      "enum": [
        "S1_BACKDOOR_C3",
        "S2_NOISY_DECOY_C5",
        "S1_S2_COMBINED",
        "S3_COLLUSION_C2_C3"
      ],
      "description": "Canonical scenario identifier."
    },
    "mode": {
      "type": "string",
      "enum": [
        "live",
        "replay"
      ],
      "description": "Execution modality: 'live' for real model training/evaluation, 'replay' for verified precomputed fixtures."
    },
    "status": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "FAILED",
        "INCONCLUSIVE"
      ],
      "description": "Overall outcome status of the run."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp when the result was generated or replayed."
    },
    "execution_time_seconds": {
      "type": "number",
      "minimum": 0,
      "description": "Total elapsed execution time in seconds (0.0 for instant replay)."
    },
    "seeds": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 1,
      "description": "RNG seeds evaluated in this run (typically [42, 123, 2024])."
    },
    "protocol_ref": {
      "type": "object",
      "required": [
        "protocol_id",
        "protocol_version",
        "protocol_hash"
      ],
      "properties": {
        "protocol_id": {
          "type": "string"
        },
        "protocol_version": {
          "type": "string"
        },
        "protocol_hash": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$",
          "description": "SHA-256 hash of protocol.json"
        }
      }
    },
    "baseline": {
      "type": "object",
      "required": [
        "clean_accuracy",
        "asr"
      ],
      "properties": {
        "clean_accuracy": {
          "type": "object",
          "required": [
            "mean",
            "std"
          ],
          "properties": {
            "mean": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "std": {
              "type": "number",
              "minimum": 0.0
            }
          }
        },
        "asr": {
          "type": "object",
          "required": [
            "mean",
            "std"
          ],
          "properties": {
            "mean": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "std": {
              "type": "number",
              "minimum": 0.0
            }
          }
        }
      }
    },
    "contributors": {
      "type": "object",
      "description": "Per-contributor leave-one-out metrics and verdicts (used in individual attribution scenarios).",
      "additionalProperties": {
        "type": "object",
        "required": [
          "contributor_id",
          "delta_asr",
          "clean_accuracy_drop",
          "verdict"
        ],
        "properties": {
          "contributor_id": {
            "type": "string"
          },
          "delta_asr": {
            "type": "object",
            "required": [
              "mean",
              "std"
            ],
            "properties": {
              "mean": {
                "type": "number"
              },
              "std": {
                "type": "number",
                "minimum": 0.0
              }
            }
          },
          "clean_accuracy_drop": {
            "type": "object",
            "required": [
              "mean",
              "std"
            ],
            "properties": {
              "mean": {
                "type": "number"
              },
              "std": {
                "type": "number",
                "minimum": 0.0
              }
            }
          },
          "asr_without": {
            "type": "object",
            "properties": {
              "mean": {
                "type": "number"
              },
              "std": {
                "type": "number"
              }
            }
          },
          "clean_accuracy_without": {
            "type": "object",
            "properties": {
              "mean": {
                "type": "number"
              },
              "std": {
                "type": "number"
              }
            }
          },
          "verdict": {
            "type": "string",
            "enum": [
              "CAUSALLY IMPLICATED",
              "CLEARED",
              "INCONCLUSIVE"
            ]
          },
          "verdict_details": {
            "type": "object"
          }
        }
      }
    },
    "collusion_group": {
      "type": "object",
      "description": "Collusive group analysis and joint removal verdict (used in S3 collusion scenarios).",
      "required": [
        "group",
        "without_C2_asr",
        "without_C3_asr",
        "without_group_asr",
        "delta_asr_without_group",
        "clean_accuracy_drop_without_group",
        "individual_C2_removal_preserves_backdoor",
        "individual_C3_removal_preserves_backdoor",
        "joint_removal_removes_backdoor",
        "verdict"
      ],
      "properties": {
        "group": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "without_C2_asr": {
          "type": "object",
          "required": [
            "mean",
            "std"
          ]
        },
        "without_C3_asr": {
          "type": "object",
          "required": [
            "mean",
            "std"
          ]
        },
        "without_group_asr": {
          "type": "object",
          "required": [
            "mean",
            "std"
          ]
        },
        "delta_asr_without_C2": {
          "type": "object"
        },
        "delta_asr_without_C3": {
          "type": "object"
        },
        "delta_asr_without_group": {
          "type": "object"
        },
        "clean_accuracy_without_group": {
          "type": "object"
        },
        "clean_accuracy_drop_without_group": {
          "type": "object"
        },
        "individual_C2_removal_preserves_backdoor": {
          "type": "boolean"
        },
        "individual_C3_removal_preserves_backdoor": {
          "type": "boolean"
        },
        "joint_removal_removes_backdoor": {
          "type": "boolean"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "COLLUSIVE GROUP IMPLICATED",
            "COLLUSION NOT CONFIRMED"
          ]
        }
      }
    },
    "artifact_hashes": {
      "type": "object",
      "description": "Map of artifact names to lowercase SHA-256 hex hashes.",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-fA-F0-9]{64}$"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Explicit caveats and operational limitations of this evaluation."
    },
    "error_message": {
      "type": [
        "string",
        "null"
      ],
      "description": "Failure details if status is FAILED."
    }
  }
}
